import heapq

graph = {
    'S':[('A',3),('B',6),('C',5)],
    'A':[('D',9),('E',8)],
    'B':[('F',12)],
    'C':[('G',14)],
    'D':[],
    'E':[],
    'F':[],
    'G':[]
}

heuristic = {
    'S':10,'A':7,'B':6,'C':8,
    'D':0,'E':3,'F':0,'G':0
}

def best_first(start, goal):
    pq = [(heuristic[start], start, [start])]
    visited = []

    while pq:
        h, node, path = heapq.heappop(pq)

        if node == goal:
            return path

        if node not in visited:
            visited.append(node)

            for neighbor,cost in graph[node]:
                heapq.heappush(pq,
                    (heuristic[neighbor], neighbor, path+[neighbor]))
    return None

goals = ['D','F']

for g in goals:
    print("Path to", g, ":", best_first('S', g))
