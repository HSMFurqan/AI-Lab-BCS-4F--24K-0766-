import heapq

graph = {
    'A': {'B':4,'C':3},
    'B': {'E':12,'F':5},
    'C': {'D':7,'E':10},
    'D': {'G':5},
    'E': {'G':5},
    'F': {'G':16},
    'G': {}
}

heuristic = {
    'A':14,'B':12,'C':11,
    'D':6,'E':4,'F':11,'G':0
}

def astar(start, goal):
    pq = [(heuristic[start], 0, start, [start])]
    visited = []

    while pq:
        f, g, node, path = heapq.heappop(pq)

        if node == goal:
            return path, g

        if node not in visited:
            visited.append(node)

            for neighbor in graph[node]:
                new_g = g + graph[node][neighbor]
                new_f = new_g + heuristic[neighbor]
                heapq.heappush(pq,
                    (new_f, new_g, neighbor, path+[neighbor]))
    return None

print("A*:", astar('A','G'))
