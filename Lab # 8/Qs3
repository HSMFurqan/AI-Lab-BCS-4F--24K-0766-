from pgmpy.models import BayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

model2 = BayesianNetwork([
    ('Disease','Fever'),
    ('Disease','Cough'),
    ('Disease','Fatigue'),
    ('Disease','Chills')
])

cpd_D = TabularCPD('Disease',2,[[0.3],[0.7]])

cpd_Fever = TabularCPD('Fever',2,
                       [[0.9,0.5],[0.1,0.5]],
                       evidence=['Disease'], evidence_card=[2])

cpd_Cough = TabularCPD('Cough',2,
                       [[0.8,0.6],[0.2,0.4]],
                       evidence=['Disease'], evidence_card=[2])

cpd_Fatigue = TabularCPD('Fatigue',2,
                         [[0.7,0.3],[0.3,0.7]],
                         evidence=['Disease'], evidence_card=[2])

cpd_Chills = TabularCPD('Chills',2,
                        [[0.6,0.4],[0.4,0.6]],
                        evidence=['Disease'], evidence_card=[2])

model2.add_cpds(cpd_D, cpd_Fever, cpd_Cough, cpd_Fatigue, cpd_Chills)

infer2 = VariableElimination(model2)

q1 = infer2.query(['Disease'], evidence={'Fever':0,'Cough':0})
q2 = infer2.query(['Disease'], evidence={'Fever':0,'Cough':0,'Chills':0})
q3 = infer2.query(['Fatigue'], evidence={'Disease':0})

print(q1)
print(q2)
print(q3)
