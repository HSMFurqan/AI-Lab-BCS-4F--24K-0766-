import numpy as np

states = ["Sunny","Cloudy","Rainy"]

transition = np.array([
    [0.6,0.3,0.1],
    [0.3,0.4,0.3],
    [0.2,0.3,0.5]
])

np.random.seed(42)

def simulate():
    current = 0
    rainy_count = 0
    for _ in range(10):
        if states[current] == "Rainy":
            rainy_count += 1
        current = np.random.choice([0,1,2], p=transition[current])
    return rainy_count

trials = 10000
count = 0

for _ in range(trials):
    if simulate() >= 3:
        count += 1

print(count / trials)
