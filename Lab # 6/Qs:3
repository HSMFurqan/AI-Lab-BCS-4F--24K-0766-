import random

POP_SIZE = 6
GENES = 5
GENERATIONS = 15
MUTATION_RATE = 0.1

def fitness(x):
    return x*x + 2*x

def random_chromosome():
    return ''.join(random.choice('01') for _ in range(GENES))

def decode(chromosome):
    return int(chromosome, 2)

def selection(population):
    population.sort(key=lambda c: fitness(decode(c)), reverse=True)
    return population[:2]

def crossover(p1, p2):
    point = random.randint(1, GENES-1)
    c1 = p1[:point] + p2[point:]
    c2 = p2[:point] + p1[point:]
    return c1, c2

def mutate(chromosome):
    chromosome = list(chromosome)
    for i in range(len(chromosome)):
        if random.random() < MUTATION_RATE:
            chromosome[i] = '1' if chromosome[i] == '0' else '0'
    return ''.join(chromosome)

population = [random_chromosome() for _ in range(POP_SIZE)]

for gen in range(GENERATIONS):

    print("Generation", gen)

    for c in population:
        x = decode(c)
        print(c, "x =", x, "fitness =", fitness(x))

    parents = selection(population)

    new_population = parents[:]

    while len(new_population) < POP_SIZE:
        c1, c2 = crossover(parents[0], parents[1])
        c1 = mutate(c1)
        c2 = mutate(c2)
        new_population.extend([c1, c2])

    population = new_population[:POP_SIZE]
    print()

best = max(population, key=lambda c: fitness(decode(c)))

print("Best chromosome:", best)
print("Best x:", decode(best))
print("Best fitness:", fitness(decode(best)))
