import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

df = pd.read_csv("Mall_Customers.csv")

# Drop ID
df_clean = df.drop(columns=['CustomerID'])

# Convert categorical if any (Gender)
df_clean = pd.get_dummies(df_clean, drop_first=True)

# ---------------- WITHOUT SCALING ----------------
k1 = KMeans(n_clusters=5, random_state=42, n_init=10)
labels_raw = k1.fit_predict(df_clean)

# ---------------- WITH SCALING ----------------
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df_clean)

k2 = KMeans(n_clusters=5, random_state=42, n_init=10)
labels_scaled = k2.fit_predict(X_scaled)

df['Cluster_Raw'] = labels_raw
df['Cluster_Scaled'] = labels_scaled

print(df.head())
