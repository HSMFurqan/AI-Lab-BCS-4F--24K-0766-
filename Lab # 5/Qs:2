import heapq
import random

graph = {
    'A':{'B':4,'C':3},
    'B':{'D':5},
    'C':{'D':7},
    'D':{}
}

heuristic = {
    'A':7,'B':4,'C':2,'D':0
}

def astar(start, goal):
    pq = [(heuristic[start], 0, start, [start])]
    visited = []

    while pq:
        f, g, node, path = heapq.heappop(pq)

        if node == goal:
            return path, g

        if node not in visited:
            visited.append(node)

            for neighbor in graph[node]:
                new_g = g + graph[node][neighbor]
                new_f = new_g + heuristic[neighbor]
                heapq.heappush(pq,
                    (new_f, new_g, neighbor, path+[neighbor]))

    return None


# Initial run
print("Initial:", astar('A','D'))

# Dynamic change
u = 'A'
v = 'B'
old = graph[u][v]
graph[u][v] = random.randint(1,10)

print("Edge Changed:", u,"-",v,"=",graph[u][v])

# Recompute
print("Updated:", astar('A','D'))
